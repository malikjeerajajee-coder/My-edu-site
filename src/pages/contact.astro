---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';

const title = 'Contact TaleemMarkaz — Email, WhatsApp & Support | taleemmarkaz.com';
const description = 'Contact TaleemMarkaz at taleemmarkazofficial@gmail.com or WhatsApp +92 337 9244731. Content requests, corrections, partnerships and student support.';

const faqs = [
  { q: 'What is the fastest way to reach TaleemMarkaz?', a: 'WhatsApp at +92 337 9244731 is the fastest channel for urgent questions and content requests. We typically respond within a few hours during business hours (9 AM – 9 PM PKT, Monday to Saturday).' },
  { q: 'How long does email support take?', a: 'Emails to taleemmarkazofficial@gmail.com are usually answered within 24–48 hours on weekdays. Weekend replies may take longer.' },
  { q: 'Can I request a past paper or textbook that is missing?', a: 'Yes. Send the board, class, subject and year (for papers) or the exact book title (for textbooks) via WhatsApp or email. We prioritise requests with the highest student demand.' },
  { q: 'I found incorrect information on a page. How do I report it?', a: 'Email us with the page URL and a description of the error. We review every correction within 72 hours.' },
  { q: 'Do you accept partnerships, guest posts, or advertisements?', a: 'We do not run advertisements or accept paid placements. We are open to educational partnerships with boards, publishers and NGOs — contact us by email with a formal proposal.' },
  { q: 'Is my personal data collected when I contact you?', a: 'Only the information you voluntarily send in your message (name, email, phone number, message text). We do not share, sell, or use it for marketing. See our privacy policy for full details.' }
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': 'https://taleemmarkaz.com/contact/',
    name: 'Contact TaleemMarkaz',
    url: 'https://taleemmarkaz.com/contact/',
    description,
    inLanguage: 'en-PK'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'TaleemMarkaz',
    url: 'https://taleemmarkaz.com',
    email: 'taleemmarkazofficial@gmail.com',
    telephone: '+92-337-9244731',
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'taleemmarkazofficial@gmail.com',
        telephone: '+92-337-9244731',
        availableLanguage: ['English', 'Urdu'],
        hoursAvailable: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'],
          opens: '09:00',
          closes: '21:00'
        }
      }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://taleemmarkaz.com/' },
      { '@type': 'ListItem', position: 2, name: 'Contact' }
    ]
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-7 lg:px-10 lg:py-24">
      <nav class="mb-8 flex flex-wrap items-center gap-1.5 text-xs font-semibold text-slate-400">
        <a href={url('/')} class="hover:text-[#1d4ed8]">Home</a><span>/</span><span class="text-slate-500">Contact</span>
      </nav>
      <h1 class="font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">Get in touch with TaleemMarkaz</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-700">Content requests, corrections, partnerships, or student support — we read every message and reply personally. Choose the channel that works best for you.</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1000px] px-5 py-16 sm:px-7 lg:px-10 lg:py-20">
    <div class="grid gap-5 lg:grid-cols-2">
      <a href="mailto:taleemmarkazofficial@gmail.com" class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-8 transition-all hover:border-[#1d4ed8] hover:shadow-lg">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-[#1d4ed8]"><Icon name="mail" size={22} /></div>
        <h2 class="mt-6 font-display text-xl font-extrabold tracking-tight text-slate-900">Email us</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Best for detailed content requests, partnership proposals, and formal correspondence.</p>
        <div class="mt-6 font-semibold text-[#1d4ed8]">taleemmarkazofficial@gmail.com</div>
        <div class="mt-1 text-xs text-slate-500">Replies within 24–48 hours (weekdays)</div>
      </a>

      <a href="https://wa.me/923379244731" target="_blank" rel="noopener" class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-8 transition-all hover:border-green-500 hover:shadow-lg">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-100 text-green-700"><Icon name="message-circle" size={22} /></div>
        <h2 class="mt-6 font-display text-xl font-extrabold tracking-tight text-slate-900">WhatsApp</h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">Fastest way to reach us. Send us the board, class and subject you need — we usually reply within hours.</p>
        <div class="mt-6 font-semibold text-green-700">+92 337 9244731</div>
        <div class="mt-1 text-xs text-slate-500">Mon–Sat, 9 AM – 9 PM PKT</div>
      </a>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-8">
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900">What to include in your message</h2>
      <p class="mt-3 text-slate-600">The more specific you are, the faster we can help. Please include:</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        <li class="flex items-start gap-2 text-sm text-slate-700"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#1d4ed8]" /><span><strong>For content requests:</strong> Board, class, subject, year (for papers), or exact book title (for textbooks)</span></li>
        <li class="flex items-start gap-2 text-sm text-slate-700"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#1d4ed8]" /><span><strong>For corrections:</strong> The page URL and what's incorrect</span></li>
        <li class="flex items-start gap-2 text-sm text-slate-700"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#1d4ed8]" /><span><strong>For partnerships:</strong> Your organisation name and a brief proposal</span></li>
        <li class="flex items-start gap-2 text-sm text-slate-700"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-[#1d4ed8]" /><span><strong>For support:</strong> The class and board you're studying under</span></li>
      </ul>
    </div>

    <div class="mt-8 rounded-2xl border-2 border-blue-100 bg-blue-50 p-8">
      <h2 class="font-display text-lg font-extrabold text-blue-900">Our response commitment</h2>
      <p class="mt-2 text-sm leading-relaxed text-blue-900">Every message is read by a human. Automated replies are never used. If you don't receive a response within 48 hours on a weekday, please resend — your original message may not have reached us.</p>
    </div>
  </section>

  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-[900px] px-5 py-16 sm:px-7 lg:px-10 lg:py-20">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Frequently asked questions</h2>
      <div class="mt-8 space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-2xl border border-slate-200 bg-white" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 text-left">
              <span class="font-display text-base font-bold text-slate-900 sm:text-lg">{f.q}</span>
              <Icon name="chevron-down" size={20} class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
            </summary>
            <div class="border-t border-slate-200 px-6 py-5 text-slate-700 leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
