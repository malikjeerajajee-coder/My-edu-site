---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';
import { BOARDS } from '../../lib/boards';
import { getSubjectIndex, classBand } from '../../lib/boardContent';

const subjects = await getSubjectIndex();
const bslug = (name: string) => {
  const b = BOARDS.find((x: any) => x.name === name);
  return b ? b.slug : name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
};

const BANDS = ['SSC (Matric)', 'HSSC (Intermediate)', 'Primary & Middle'];
const cards: any[] = [];
for (const s of subjects) {
  for (const band of BANDS) {
    const pairs = s.pairs.filter((p: any) => classBand(p.cls) === band);
    if (pairs.length) cards.push({ ...s, band, pairs });
  }
}
const groups = BANDS.map(b => ({ band: b, cards: cards.filter(c => c.band === b) })).filter(g => g.cards.length);

const allClasses = [...new Set(subjects.flatMap((s: any) => s.classes))].sort((a, b) => Number(a) - Number(b));
const allBoards = [...new Set(subjects.flatMap((s: any) => s.boards))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All Subjects — Pakistani Boards',
  description: `${subjects.length} subjects across ${allBoards.length} boards and Class ${allClasses[0]} to ${allClasses[allClasses.length - 1]}, derived from real board curricula.`,
};
---

<BaseLayout
  title="All Subjects — Every Pakistani Board & Class | Parhayi"
  description={`Browse ${subjects.length} subjects offered by Pakistani boards — from Mathematics and Biology to Banking, Sindhi and Business Maths. Organised by class and board.`}
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 pt-14 pb-16 sm:px-7 lg:px-10 lg:pt-20 lg:pb-24">
      <nav class="mb-5 flex flex-wrap items-center gap-1.5 text-xs font-semibold text-slate-400">
        <a href={url('/')} class="hover:text-[#1d4ed8]">Home</a>
        <span>/</span>
        <span class="text-slate-500">Subjects</span>
      </nav>
      <h1 class="max-w-4xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">Every subject, every board.</h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Subjects change with your class and your board — Matric science groups study Biology, Inter commerce groups study Banking and Accounting, Sindh boards teach Sindhi. This directory is built from the subjects boards actually publish, not a fixed list.
      </p>
      <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-4">
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Subjects</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">{subjects.length}</dd>
        </div>
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Boards</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">{allBoards.length}</dd>
        </div>
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Classes</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">{allClasses[0]}–{allClasses[allClasses.length - 1]}</dd>
        </div>
      </dl>
    </div>
  </section>

  {groups.map(g => (
    <section class="mx-auto max-w-[1200px] px-5 py-14 sm:px-7 lg:px-10 lg:py-16">
      <div class="mb-8">
        <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900">{g.band}</h2>
        <p class="mt-1.5 text-sm text-slate-500">Subjects offered in {g.band} — tap a subject to see which boards and classes have material.</p>
      </div>
      <div class="space-y-3">
        {g.cards.map(c => (
          <details class="group rounded-2xl border border-slate-200 bg-white overflow-hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 transition-colors hover:bg-slate-50">
              <div class="flex items-center gap-3 min-w-0">
                <h3 class="font-display text-lg font-extrabold tracking-tight text-slate-900">{c.name}</h3>
                <span class="shrink-0 rounded bg-slate-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500">{c.total} resources</span>
              </div>
              <Icon name="chevron-right" size={18} strokeWidth={2.4} class="shrink-0 text-slate-400 transition-transform group-open:rotate-90" />
            </summary>
            <div class="border-t border-slate-100 bg-slate-50/50 p-5">
              <div class="flex flex-wrap gap-2">
                {c.pairs.map((p: any) => (
                  <a href={url(`/board/${bslug(p.board)}/class-${p.cls}/${c.slug}`)} class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">
                    {p.board} · Class {p.cls}
                  </a>
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}

  <section class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-[820px] px-5 py-16 sm:px-7 lg:px-10">
      <div class="prose">
        <h2>Why subject lists differ by board and class</h2>
        <p>Pakistani boards do not share one syllabus menu. In <strong>SSC (Class 9–10)</strong> every student takes the compulsory core — English, Urdu, Islamiat and Pakistan Studies — then electives by group: Biology, Chemistry, Physics and Mathematics for science groups, or General Science and General Mathematics for arts groups. Provincial boards add their own language papers, such as Sindhi in Sindh or Pashto in KPK.</p>
        <p>In <strong>HSSC (Class 11–12)</strong> the menu widens further: Pre-Medical, Pre-Engineering, Computer Science, Commerce and Arts groups each carry different electives — Botany, Zoology, Economics, Statistics, Banking, Accounting, Business Mathematics and more. Federal Board (FBISE) also publishes its own optional subjects that provincial boards may not offer.</p>
        <p>That is why this directory is generated from the material boards actually publish for each class, instead of a single fixed subject list. If a subject appears here, there is real content behind it for that board and class.</p>
      </div>
    </div>
  </section>
</BaseLayout>
