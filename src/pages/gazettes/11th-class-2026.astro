---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

const title = '11th Class Result Gazette 2026 Punjab Boards — Download PDF | TaleemMarkaz';
const description = 'Download the official 11th Class (1st Year / HSSC Part-I) Result Gazette 2026 PDF for all Punjab boards. Expected date: Oct 22, 2026. Board-wise links and search instructions.';

const boards = [
  { name: 'BISE Lahore', url: 'https://www.biselahore.com/', slug: 'lahore' },
  { name: 'BISE Gujranwala', url: 'https://www.bisegrw.edu.pk/', slug: 'gujranwala' },
  { name: 'BISE Rawalpindi', url: 'https://www.biserawalpindi.edu.pk/', slug: 'rawalpindi' },
  { name: 'BISE Faisalabad', url: 'https://www.bisefsd.edu.pk/', slug: 'faisalabad' },
  { name: 'BISE Multan', url: 'https://web.bisemultan.edu.pk/', slug: 'multan' },
  { name: 'BISE Sargodha', url: 'https://www.bisesargodha.edu.pk/', slug: 'sargodha' },
  { name: 'BISE Bahawalpur', url: 'https://www.bisebwp.edu.pk/', slug: 'bahawalpur' },
  { name: 'BISE Dera Ghazi Khan', url: 'https://www.bisedgkhan.edu.pk/', slug: 'dg-khan' },
  { name: 'BISE Sahiwal', url: 'https://www.bisesahiwal.edu.pk/', slug: 'sahiwal' },
];

const faqs = [
  { q: 'When will the 11th Class Result 2026 be announced in Punjab?', a: 'The currently reported date is October 22, 2026, at 10:00 AM Pakistan Standard Time. Check your respective board\'s official announcement for confirmation.' },
  { q: 'When will the 11th Class Result Gazette 2026 be available?', a: 'The gazette should be checked on the relevant board\'s website after the official result announcement. The exact upload time and availability of a PDF may differ by board.' },
  { q: 'How can I download the Punjab Board 1st Year Result Gazette 2026?', a: 'Visit your board\'s official website, open its results or downloads section and look for the HSSC Part-I Annual Examination 2026 gazette. Download only the correct examination-year file.' },
  { q: 'Can I check my 11th Class Result 2026 by roll number?', a: 'Yes. Use your board\'s official online result service when it becomes available and enter the roll number printed on your examination slip.' },
  { q: 'Can I find my First Year result by name?', a: 'This depends on the available result service or gazette format. You may be able to search a PDF by name, but always confirm the result using your roll number and official board record.' },
  { q: 'Is the 11th Class Result Gazette the same for all Punjab Boards?', a: 'No. Each board maintains its own examination records and may publish a separate gazette. Always use the gazette corresponding to your examination board.' },
  { q: 'What should I do if the result website is not opening?', a: 'Wait briefly and try again. You can also check the board\'s official announcements or ask your college for guidance. Avoid relying on unverified result screenshots or unofficial claims.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://taleemmarkaz.com/gazettes/11th-class-2026/#page',
    name: title,
    url: 'https://taleemmarkaz.com/gazettes/11th-class-2026/',
    description,
    inLanguage: 'en-PK',
    dateModified: '2026-10-19',
    isPartOf: { '@id': 'https://taleemmarkaz.com/#website' },
    publisher: { '@type': 'Organization', '@id': 'https://taleemmarkaz.com/#organization', name: 'TaleemMarkaz', url: 'https://taleemmarkaz.com' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://taleemmarkaz.com/' },
      { '@type': 'ListItem', position: 2, name: 'Gazettes', item: 'https://taleemmarkaz.com/gazettes/' },
      { '@type': 'ListItem', position: 3, name: '11th Class Gazette 2026' }
    ]
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>

  <!-- Hero -->
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 pt-14 pb-16 sm:px-7 lg:px-10 lg:pt-20 lg:pb-24">
      <nav class="mb-8 flex flex-wrap items-center gap-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-400">
        <a href={url('/')} class="hover:text-slate-700">Home</a><span>/</span>
        <a href={url('/gazettes')} class="hover:text-slate-700">Gazettes</a><span>/</span>
        <span class="text-slate-500">11th Class 2026</span>
      </nav>

      <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#1d4ed8]">
        <span class="h-1.5 w-1.5 rounded-full bg-[#1d4ed8]"></span>
        HSSC Part-I Annual Examination 2026
      </div>

      <h1 class="mt-6 max-w-4xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        11th Class Result Gazette 2026 — Punjab Boards.
      </h1>

      <p class="mt-6 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Download the official <strong class="text-slate-900">1st Year (11th Class) Result Gazette 2026 PDF</strong> for all Punjab boards. Expected announcement: <strong class="text-slate-900">October 22, 2026</strong> at 10:00 AM PKT. Board-wise links and search instructions below.
      </p>

      <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 sm:flex sm:flex-wrap sm:gap-x-14">
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Result Date</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">Oct 22, 2026</dd>
        </div>
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Time</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">10:00 AM</dd>
        </div>
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Class</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">11th (First Year)</dd>
        </div>
        <div>
          <dt class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Status</dt>
          <dd class="mt-1 font-display text-2xl font-extrabold tracking-tight text-slate-900">Awaiting</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Content -->
  <article class="mx-auto max-w-[900px] px-5 py-14 sm:px-7 lg:px-10 lg:py-16">
    
    <p class="text-base leading-relaxed text-slate-600 sm:text-lg">
      The 11th Class Result Gazette 2026 for all Punjab Boards is one of the most anticipated resources for students who appeared in the First Year annual examinations. Students will be able to use their respective Board of Intermediate and Secondary Education (BISE) websites to check their results.
    </p>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      On this page, you can find the latest updates about the Punjab Board 11th Class Result Gazette 2026, board-wise result information, PDF availability, and instructions for checking your HSSC Part-I result.
    </p>

    <div class="mt-8 rounded-2xl border-2 border-yellow-300 bg-yellow-50 p-6">
      <div class="flex items-start gap-4">
        <Icon name="alert-triangle" size={20} class="mt-0.5 shrink-0 text-yellow-600" />
        <div>
          <div class="font-display text-base font-extrabold text-yellow-900">Important Note</div>
          <p class="mt-1.5 text-sm leading-relaxed text-yellow-900">
            The 2026 gazette should only be marked available after the correct HSSC Part-I annual examination file has been published. <strong>Do not use an old gazette or a Class 12 result file</strong> in place of the 11th Class Result Gazette 2026.
          </p>
        </div>
      </div>
    </div>

    <h2 class="mt-14 font-display text-2xl font-extrabold tracking-tight text-slate-900">Punjab Boards 11th Class Result Gazette 2026 – Board-Wise Links</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      Students can use the following official board websites to find their result announcements and gazette publications. Download links should be added here once the relevant 2026 files become available.
    </p>

    <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Punjab Board</th>
            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Official Website</th>
            <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500">Result Hub</th>
          </tr>
        </thead>
        <tbody>
          {boards.map(b => (
            <tr class="border-t border-slate-100">
              <td class="px-6 py-4 font-semibold text-slate-900">{b.name}</td>
              <td class="px-6 py-4">
                <a href={b.url} target="_blank" rel="noopener" class="break-all text-[#1d4ed8] hover:underline">{b.url}</a>
              </td>
              <td class="px-6 py-4">
                <a href={url(`/results/${b.slug}/class-11/`)} class="whitespace-nowrap rounded-lg bg-[#1d4ed8] px-3 py-1.5 text-xs font-bold transition-colors hover:bg-[#1e3a8a]" style="color:#ffffff">Check Result</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-sm text-slate-500 italic">These links lead to board websites, not guaranteed direct gazette download files. Check each website's results or downloads section for the correct 2026 publication.</p>

    <h2 class="mt-14 font-display text-2xl font-extrabold tracking-tight text-slate-900">How to Download the 11th Class Result Gazette 2026 PDF</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">Follow these steps after your board publishes its official gazette:</p>
    <ol class="mt-4 space-y-2 text-base leading-relaxed text-slate-600 sm:text-lg list-decimal pl-5">
      <li>Open the official website of your Punjab education board.</li>
      <li>Find the <strong>Results</strong>, <strong>Notifications</strong>, or <strong>Gazette</strong> section.</li>
      <li>Look for HSSC Part-I, 11th Class, or First Year Annual Examination 2026.</li>
      <li>Open the correct result gazette PDF, if provided.</li>
      <li>Download the file to your device.</li>
      <li>Open the PDF and use the search function (Ctrl+F) to locate your roll number or name, where supported.</li>
      <li>Verify the result against your board's official result portal or issued result card.</li>
    </ol>

    <h2 class="mt-14 font-display text-2xl font-extrabold tracking-tight text-slate-900">How to Check the 11th Class Result 2026 by Roll Number</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      Students can also check their First Year results online without downloading a complete gazette:
    </p>
    <ol class="mt-4 space-y-2 text-base leading-relaxed text-slate-600 sm:text-lg list-decimal pl-5">
      <li>Visit your respective board's official website.</li>
      <li>Open the online results portal.</li>
      <li>Select Intermediate Part-I, HSSC Part-I, or 11th Class.</li>
      <li>Choose the First Annual Examination 2026, where applicable.</li>
      <li>Enter your roll number.</li>
      <li>Submit the information to view your result.</li>
    </ol>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      Keep your roll number slip available when checking the result. If the website is temporarily slow after the announcement, try again after a short interval or consult your board's official alternative result service.
    </p>

    <h2 class="mt-14 font-display text-2xl font-extrabold tracking-tight text-slate-900">FA, FSc, ICS, and ICom Result Gazette 2026</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      The HSSC Part-I examination includes students from different intermediate study groups. Students in FA, FSc, ICS, and ICom should select the correct examination and board information when checking their results.
    </p>
    <ul class="mt-4 space-y-2 text-base leading-relaxed text-slate-600 sm:text-lg list-disc pl-5">
      <li><strong>FA:</strong> Check your HSSC Part-I result using the information associated with your examination.</li>
      <li><strong>FSc Pre-Medical:</strong> Verify your result and subject marks against your official record.</li>
      <li><strong>FSc Pre-Engineering:</strong> Use your board's HSSC Part-I result service.</li>
      <li><strong>ICS:</strong> Check the result for your registered subject combination.</li>
      <li><strong>ICom:</strong> Use the appropriate First Year examination details.</li>
    </ul>

    <h2 class="mt-14 font-display text-2xl font-extrabold tracking-tight text-slate-900">What If the Gazette Is Not Available?</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
      The online result and the gazette may not become accessible at exactly the same time. If the gazette download link is not available immediately after the result announcement:
    </p>
    <ol class="mt-4 space-y-2 text-base leading-relaxed text-slate-600 sm:text-lg list-decimal pl-5">
      <li>Check the latest announcement on your board's official website.</li>
      <li>Try the online result portal using your roll number.</li>
      <li>Revisit the gazette or downloads section later.</li>
      <li>Contact your college or the relevant board if you need help confirming your result.</li>
    </ol>

  </article>

  <!-- FAQ -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-[900px] px-5 py-14 sm:px-7 lg:px-10 lg:py-16">
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-slate-900">Punjab Board 11th Class Result 2026 – FAQs</h2>
      <div class="mt-8 space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-2xl border border-slate-200 bg-white" open={i === 0}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-6 text-left">
              <span class="font-display text-base font-bold text-slate-900">{f.q}</span>
              <Icon name="chevron-down" size={20} class="shrink-0 text-slate-400 transition-transform group-open:rotate-180" />
            </summary>
            <div class="border-t border-slate-200 px-6 py-5 text-sm leading-relaxed text-slate-600">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
