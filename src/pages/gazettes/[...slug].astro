---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Hero from '../../components/ui/Hero.astro';
import MetaGrid from '../../components/ui/MetaGrid.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const gazettes = await getCollection('gazettes');
  return gazettes.map(g => ({ params: { slug: g.id }, props: { gazette: g } }));
}

const { gazette } = Astro.props;
const d = gazette.data;

const idMatch = d.driveUrl.match(/drive\.google\.com\/file\/d\/([\w-]+)/) || d.driveUrl.match(/[?&]id=([\w-]+)/);
const driveId = idMatch ? idMatch[1] : null;
const downloadUrl = driveId ? `https://drive.google.com/uc?export=download&id=${driveId}` : d.driveUrl;

const boardSlug = d.board.toLowerCase();
const biseLabel = d.bise ? `${d.bise} Board` : `${d.board} Board`;

const all = await getCollection('gazettes');
const sameBise = all
  .filter((g: any) => g.id !== gazette.id && g.data.board === d.board && g.data.class === d.class && (g.data.bise || '') === (d.bise || ''))
  .sort((a: any, b: any) => (b.data.year || 0) - (a.data.year || 0));
const sameBoard = all
  .filter((g: any) => g.id !== gazette.id && g.data.board === d.board && g.data.class === d.class && (g.data.bise || '') !== (d.bise || ''))
  .sort((a: any, b: any) => (b.data.year || 0) - (a.data.year || 0));
const related = [...sameBise, ...sameBoard].slice(0, 6);

const metaItems = [
  { label: 'Board', value: d.board },
  { label: 'BISE', value: d.bise || 'Federal (FBISE)' },
  { label: 'Class', value: `Class ${d.class}` },
  { label: 'Exam', value: d.examType },
  { label: 'Year', value: String(d.year) },
  ...(d.variant ? [{ label: 'District / Section', value: d.variant }] : []),
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://parhayi.pages.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Result Gazettes', item: 'https://parhayi.pages.dev/gazettes/' },
      { '@type': 'ListItem', position: 3, name: d.board, item: `https://parhayi.pages.dev/board/${boardSlug}/` },
      { '@type': 'ListItem', position: 4, name: d.title },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'DigitalDocument',
    name: d.title,
    description: `${biseLabel} ${d.examType} result gazette for Class ${d.class}, ${d.year}.`,
    educationalLevel: `Class ${d.class}`,
    datePublished: `${d.year}`,
    inLanguage: 'en',
    isAccessibleForFree: true,
    url: `https://parhayi.pages.dev/gazettes/${gazette.id}/`,
    publisher: { '@type': 'Organization', name: 'Parhayi', url: 'https://parhayi.pages.dev/' },
  },
];
---

<BaseLayout
  data-pagefind-body
  jsonLd={jsonLd}
  title={`${d.title} — Parhayi`}
  description={`${biseLabel} ${d.examType} result gazette for Class ${d.class}, ${d.year}. Open or download the official document on Google Drive — free, no sign-up.`}
>
  <div class="mx-auto w-full max-w-[900px] px-4 pt-8 sm:px-6 sm:pt-12 lg:px-8">
    <nav class="mb-5 flex flex-wrap items-center gap-1.5 text-xs font-semibold text-slate-400">
      <a href={url('/')} class="transition-colors hover:text-[#1d4ed8]">Home</a>
      <span>/</span>
      <a href={url('/gazettes')} class="transition-colors hover:text-[#1d4ed8]">Gazettes</a>
      <span>/</span>
      <a href={url(`/board/${boardSlug}`)} class="transition-colors hover:text-[#1d4ed8]">{d.board}</a>
      <span>/</span>
      <span class="truncate text-slate-500">Class {d.class} · {d.year}</span>
    </nav>

    <a href={url('/gazettes')} class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-[#1d4ed8]">
      <Icon name="arrow-left" size={16} strokeWidth={2.4} /> Back to gazettes
    </a>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-primary">{d.year}</span>
        <span class="badge badge-primary">{d.examType}</span>
        <span class="badge badge-secondary">Class {d.class}</span>
        {d.variant && <span class="badge badge-secondary">{d.variant}</span>}
      </div>

      <h1 class="mt-4 font-display text-2xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-3xl">{d.title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-slate-500">Official result gazette published by {biseLabel}, hosted on Google Drive. Open it in a new tab or download the PDF directly.</p>

      <div class="mt-5 flex flex-col gap-2.5 sm:flex-row">
        <a href={d.driveUrl} target="_blank" rel="noopener" class="btn-primary">
          <Icon name="external-link" size={18} strokeWidth={2.4} /> Open in Google Drive
        </a>
        <a href={downloadUrl} target="_blank" rel="noopener" class="btn-secondary">
          <Icon name="download" size={18} strokeWidth={2.4} /> Download PDF
        </a>
      </div>

      <MetaGrid items={metaItems} />
    </div>

    {related.length > 0 && (
      <div class="mt-10">
        <SectionHeader 
          title={`More Class ${d.class} gazettes — ${d.bise ? `${d.bise} Board` : d.board}`}
        />
        <div class="seamed-grid mt-5 grid-cols-1 sm:grid-cols-2">
          {related.map((r: any) => (
            <a href={url(`/gazettes/${r.id}`)} class="group flex items-center justify-between gap-4 card">
              <div class="min-w-0">
                <div class="text-[11px] font-bold uppercase tracking-[0.1em] text-slate-400">{r.data.year} · {r.data.examType}{r.data.variant ? ` · ${r.data.variant}` : ''}</div>
                <div class="mt-1 truncate text-sm font-bold text-slate-900 transition-colors group-hover:text-[#1d4ed8]">{r.data.title}</div>
              </div>
              <Icon name="arrow-right" size={16} strokeWidth={2.4} class="shrink-0 text-slate-300 transition-colors group-hover:text-[#1d4ed8]" />
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-10 flex flex-wrap gap-2">
      <a href={url('/gazettes')} class="rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">All gazettes</a>
      <a href={url(`/board/${boardSlug}`)} class="rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">{d.board} board hub</a>
    </div>

    <div class="pb-16 pt-10">
      <a href={url('/gazettes')} class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-[#1d4ed8]">
        <Icon name="arrow-left" size={16} strokeWidth={2.4} /> Back to all gazettes
      </a>
    </div>
  </div>
</BaseLayout>
