---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SubjectIcon from '../../components/SubjectIcon.astro';
import MetaGrid from '../../components/ui/MetaGrid.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { url } from '../../lib/url';
import { boardMeta, bookSeoTitle, bookSeoDescription, bookSubjectName, subjectSlug } from '../../lib/bookSeo';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book: any) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const d = book.data;
const boardName = (d.boards || [])[0] || 'Punjab';
const meta = boardMeta(boardName);
const subj = bookSubjectName(d.subject);

const boardSlug = boardName.toLowerCase();
const subjSlug = subjectSlug(subj);

const allBooks = await getCollection('books');
const relatedBooks = allBooks.filter((b: any) =>
  b.id !== book.id &&
  (b.data.boards || []).includes(boardName) &&
  String(b.data.class) === String(d.class)
).slice(0, 8);

const [notes, quizzes, papers] = await Promise.all([
  getCollection('notes'),
  getCollection('quizzes'),
  getCollection('pastPapers'),
]);

const slugMatch = (s: string) => subjectSlug(bookSubjectName(s)) === subjSlug;

const relatedNotes = notes.filter((n: any) =>
  String(n.data.class) === String(d.class) &&
  (n.data.boards || []).includes(boardName) &&
  slugMatch(n.data.subject)
).slice(0, 3);

const relatedQuizzes = quizzes.filter((q: any) =>
  String(q.data.class) === String(d.class) &&
  (q.data.boards || []).includes(boardName) &&
  slugMatch(q.data.subject)
).slice(0, 3);

const relatedPapers = papers.filter((p: any) =>
  String(p.data.class) === String(d.class) &&
  (p.data.boards || []).includes(boardName) &&
  slugMatch(p.data.subject)
).slice(0, 3);

const metaItems = [
  { label: 'Board', value: boardName },
  { label: 'Class', value: `Class ${d.class}` },
  { label: 'Subject', value: subj },
  ...(d.author ? [{ label: 'Publisher', value: d.author }] : []),
  ...(d.medium ? [{ label: 'Medium', value: d.medium.charAt(0).toUpperCase() + d.medium.slice(1) }] : []),
  ...(d.year ? [{ label: 'Edition', value: d.year }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: d.title,
  author: d.author || 'Unknown',
  educationalLevel: `Class ${d.class}`,
  inLanguage: d.medium || 'en',
  url: `https://parhayi.pages.dev/textbook/${book.id}/`,
  publisher: { '@type': 'Organization', name: boardName + ' Textbook Board' },
};
---

<BaseLayout
  data-pagefind-body
  jsonLd={jsonLd}
  title={bookSeoTitle(book, meta)}
  description={bookSeoDescription(book, meta)}
>
  <div class="mx-auto w-full max-w-[900px] px-4 pt-8 sm:px-6 sm:pt-12 lg:px-8">
    <nav class="mb-5 flex flex-wrap items-center gap-1.5 text-xs font-semibold text-slate-400">
      <a href={url('/')} class="transition-colors hover:text-[#1d4ed8]">Home</a>
      <span>/</span>
      <a href={url('/books')} class="transition-colors hover:text-[#1d4ed8]">Textbooks</a>
      <span>/</span>
      <a href={url(`/books/${boardSlug}`)} class="transition-colors hover:text-[#1d4ed8]">{boardName}</a>
      <span>/</span>
      <span class="truncate text-slate-500">Class {d.class}</span>
    </nav>

    <a href={url(`/books/${boardSlug}/class-${d.class}`)} class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-[#1d4ed8]">
      <Icon name="arrow-left" size={16} strokeWidth={2.4} /> Back to Class {d.class} textbooks
    </a>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <div class="flex items-start gap-4">
        <SubjectIcon subject={subj} size="md" />
        <div class="flex-1">
          <h1 class="font-display text-2xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-3xl">{d.title}</h1>
          <p class="mt-2 text-sm text-slate-500">Official textbook from {meta.authority}. Free PDF download.</p>
        </div>
      </div>

      <a href={d.pdfUrl} target="_blank" rel="noopener" class="mt-6 btn-primary">
        <Icon name="download" size={18} strokeWidth={2.4} /> Download PDF
      </a>

      <MetaGrid items={metaItems} />
    </div>

    {(relatedNotes.length > 0 || relatedQuizzes.length > 0 || relatedPapers.length > 0) && (
      <div class="mt-10 space-y-8">
        {relatedNotes.length > 0 && (
          <div>
            <SectionHeader title={`Related ${subj} Notes`} description="Chapter-wise revision notes for this subject." />
            <div class="seamed-grid mt-4 grid-cols-1 sm:grid-cols-3">
              {relatedNotes.map((n: any) => (
                <a href={url(`/note/${n.id}`)} class="card group">
                  <div class="card-title">{n.data.title}</div>
                  <div class="card-action mt-3">Read note <Icon name="arrow-right" size={11} strokeWidth={2.6} /></div>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedQuizzes.length > 0 && (
          <div>
            <SectionHeader title={`Related ${subj} Quizzes`} description="Interactive MCQs to test your understanding." />
            <div class="seamed-grid mt-4 grid-cols-1 sm:grid-cols-3">
              {relatedQuizzes.map((q: any) => (
                <a href={url(`/quiz/${q.id}`)} class="card group">
                  <div class="card-title">{q.data.title}</div>
                  <div class="card-action mt-3">Take quiz <Icon name="arrow-right" size={11} strokeWidth={2.6} /></div>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedPapers.length > 0 && (
          <div>
            <SectionHeader title={`Related ${subj} Past Papers`} description="Official board exam papers for practice." />
            <div class="seamed-grid mt-4 grid-cols-1 sm:grid-cols-3">
              {relatedPapers.map((p: any) => (
                <a href={url(`/past-papers/${p.id}`)} class="card group">
                  <div class="card-title">{p.data.title}</div>
                  <div class="card-action mt-3">Download <Icon name="arrow-right" size={11} strokeWidth={2.6} /></div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    {relatedBooks.length > 0 && (
      <div class="mt-10">
        <SectionHeader 
          title={`More Class ${d.class} ${boardName} Textbooks`}
          description="Other subjects available for this class and board."
        />
        <div class="seamed-grid mt-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
          {relatedBooks.map((b: any) => (
            <a href={url(`/textbook/${b.id}`)} class="card group">
              <div class="flex items-start gap-3">
                <SubjectIcon subject={bookSubjectName(b.data.subject)} size="sm" />
                <div class="min-w-0">
                  <div class="card-title">{bookSubjectName(b.data.subject)}</div>
                  <div class="card-desc mt-1">{b.data.author || boardName + ' Textbook Board'}</div>
                </div>
              </div>
              <div class="card-action mt-4">Download <Icon name="arrow-right" size={11} strokeWidth={2.6} /></div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="pb-16 pt-10">
      <a href={url(`/books/${boardSlug}/class-${d.class}`)} class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition-colors hover:text-[#1d4ed8]">
        <Icon name="arrow-left" size={16} strokeWidth={2.4} /> Back to Class {d.class} textbooks
      </a>
    </div>
  </div>
</BaseLayout>
