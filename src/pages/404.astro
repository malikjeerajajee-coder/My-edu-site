---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---
<BaseLayout
  title="Page not found — Parhayi"
  description="The page you requested does not exist. Browse past papers, notes, textbooks and result gazettes by class, board or resource type."
>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 pt-14 pb-16 sm:px-7 lg:px-10 lg:pt-20 lg:pb-24">
      <div class="flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[#1d4ed8]">
        <span class="h-1.5 w-1.5 rounded-full bg-[#1d4ed8]"></span>
        Error 404
      </div>
      <h1 class="mt-6 max-w-4xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">This page moved or never existed.</h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        If you came from an old link, we are trying to forward you automatically. Otherwise, jump straight back into the library:
      </p>
      <div class="mt-8 flex flex-wrap gap-2.5">
        <a href={url('/')} class="rounded-xl bg-[#1d4ed8] px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#1e3a8a]">Home</a>
        <a href={url('/past-papers')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">Past Papers</a>
        <a href={url('/gazettes')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">Result Gazettes</a>
        <a href={url('/notes')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">Notes</a>
        <a href={url('/subjects')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-[#1d4ed8] hover:text-[#1d4ed8]">All Subjects</a>
      </div>
    </div>
  </section>
  <script>
    const BASE = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
    const raw = location.pathname.replace(/\/+$/, '');
    const path = BASE && raw.startsWith(BASE) ? raw.slice(BASE.length) : raw;
    let to = null, m;
    if ((m = path.match(/^\/quizzes\/(.+)$/))) to = '/quiz/' + m[1];
    else if ((m = path.match(/^\/notes\/(.+)$/))) to = '/note/' + m[1];
    else if ((m = path.match(/^\/books\/(\d.+)$/))) to = '/textbook/' + m[1];
    else if ((m = path.match(/^\/board\/([^/]+)\/([^/]+)\/class-(\d+)\/[^/]+$/))) to = '/board/' + m[1] + '/' + m[2] + '/class-' + m[3];
    else if ((m = path.match(/^\/board\/([^/]+)\/([^/]+)\/class-(\d+)$/))) to = '/board/' + m[1] + '/' + m[2];
    if (to) location.replace(BASE + to + '/');
  </script>
</BaseLayout>
