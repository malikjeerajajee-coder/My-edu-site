---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { BOARDS, itemBoards } from '../../lib/boards';
import { getCollection } from 'astro:content';

const gazettes = await getCollection('gazettes');

const boardItems = BOARDS.map(board => {
  const records = gazettes.filter(g =>
    itemBoards(g.data).includes(board.name)
  );

  const years = records
    .map(g => Number(g.data.year))
    .filter(y => Number.isFinite(y) && y > 0);

  return {
    ...board,
    count: records.length,
    minYear: years.length ? Math.min(...years) : null,
    maxYear: years.length ? Math.max(...years) : null,
  };
});

const totalRecords = gazettes.length;
const site = 'https://malikjeerajajee-coder.github.io/My-edu-site';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Board Results', item: `${site}/results/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Pakistani Board Results and Result Gazettes | TaleemMarkaz',
    description: 'Browse available Pakistani examination board result gazettes by board, class and year.',
    url: `${site}/results/`,
    isPartOf: { '@type': 'WebSite', name: 'TaleemMarkaz', url: `${site}/` },
  },
];
---
<BaseLayout
  title="Pakistan Board Results & Result Gazettes | TaleemMarkaz"
  description={`Browse result gazettes from Pakistani education boards. Explore available documents by board, class and examination year. ${totalRecords} gazette records are listed.`}
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-7 lg:px-10 lg:py-20">
      <nav class="mb-5 text-xs font-semibold text-slate-400">
        <a href={url('/')} class="hover:text-blue-700">Home</a>
        <span class="mx-2">/</span>
        <span class="text-slate-600">Board Results</span>
      </nav>
      <div class="max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-wider text-blue-700">
          Pakistan examination resources
        </p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          Pakistan Board Results
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Find available examination result gazettes from Pakistani education
          boards. Choose a board to explore documents by class, examination
          type and year. Availability depends on the records listed on this site.
        </p>
        <p class="mt-4 text-sm text-slate-500">
          Currently listed: {totalRecords} gazette records.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-5 py-12 sm:px-7 lg:px-10 lg:py-16">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
      Choose your education board
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-600">
      Select a region to view its available result gazettes and related resources.
    </p>

    <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {boardItems.map(board => (
        <a
          href={url(`/results/${board.slug}`)}
          class="group rounded-xl border border-slate-200 bg-white p-5 transition hover:border-blue-300 hover:shadow-sm"
        >
          <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-blue-700">
            {board.full}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Browse {board.name} board result gazettes and available examination records.
          </p>
          <div class="mt-4 text-sm font-semibold text-blue-700">
            {board.count} listed documents
            <span aria-hidden="true"> →</span>
          </div>
          {board.minYear && board.maxYear && (
            <p class="mt-2 text-xs text-slate-500">
              Listed years: {board.minYear === board.maxYear
                ? board.minYear
                : `${board.minYear}–${board.maxYear}`}
            </p>
          )}
        </a>
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-slate-200 p-6">
      <h2 class="text-lg font-extrabold text-slate-900">
        About these result records
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">
        This directory organises available result gazette documents for easier
        browsing. A listed document does not mean that a new result has just
        been announced. For current result announcements, roll-number results
        and corrections, check the relevant examination board's official website.
      </p>
      <p class="mt-3 text-sm leading-relaxed text-slate-600">
        You can also explore <a class="font-semibold text-blue-700 hover:underline"
        href={url('/boards')}>all education boards</a> and the site's
        <a class="font-semibold text-blue-700 hover:underline"
        href={url('/gazettes')}>result gazette directory</a>.
      </p>
    </div>
  </section>
</BaseLayout>
