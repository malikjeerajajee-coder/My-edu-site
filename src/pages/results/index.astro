---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';
import { getCollection } from 'astro:content';

const gazettes = await getCollection('gazettes');
const boardGroups = new Map();

for (const g of gazettes) {
  const board = (g.data.boards || [])[0] || 'Punjab';
  const bise = g.data.bise || null;
  const cls = String(g.data.class);
  
  const boardKey = bise || board;
  
  if (!boardGroups.has(boardKey)) {
    boardGroups.set(boardKey, { board, bise, classes: new Map() });
  }
  
  const bg = boardGroups.get(boardKey);
  if (!bg.classes.has(cls)) {
    bg.classes.set(cls, { count: 0, years: new Set() });
  }
  
  const clsData = bg.classes.get(cls);
  clsData.count++;
  clsData.years.add(g.data.year);
}

const boardArray = Array.from(boardGroups.entries()).map(([key, data]) => ({
  key,
  ...data,
  classes: Array.from(data.classes.entries()).map(([cls, info]) => ({
    cls,
    ...info,
    years: Array.from(info.years).sort((a, b) => b - a)
  })).sort((a, b) => Number(a.cls) - Number(b.cls))
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pakistani Board Results Archive',
  description: 'Complete archive of result gazettes from all Pakistani boards.'
};
---

<BaseLayout
  title="Pakistani Board Results Archive | All Boards & Classes | TaleemMarkaz"
  description="Complete archive of official result gazettes from Punjab, Sindh, KPK, Balochistan, Federal, and AJK boards."
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 pt-14 pb-16 sm:px-7 lg:px-10 lg:pt-20">
      <h1 class="max-w-4xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Pakistani Board Results Archive
      </h1>
      <p class="mt-6 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Complete collection of official result gazettes from all Pakistani educational boards. Download authentic result documents.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-5 py-14 sm:px-7 lg:px-10 lg:py-16">
    <div class="space-y-10">
      {boardArray.map(bg => {
        const boardSlug = (bg.bise || bg.board).toLowerCase().replace(/[^a-z0-9]+/g, '-');
        const boardLabel = bg.bise ? `${bg.bise} Board` : (bg.board === 'Federal' ? 'Federal Board' : `${bg.board} Board`);
        
        return (
          <div>
            <h2 class="mb-6 flex items-center gap-3 font-display text-2xl font-extrabold tracking-tight text-slate-900">
              <span class="h-6 w-1.5 rounded-full bg-[#1d4ed8]"></span>
              {boardLabel}
            </h2>
            <div class="seamed-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {bg.classes.map(c => (
                <a
                  href={url(`/results/${boardSlug}/${c.cls}`)}
                  class="group relative flex flex-col bg-white p-6 transition-colors hover:bg-slate-50"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="text-[11px] font-bold uppercase tracking-[0.1em] text-[#1d4ed8]">Class {c.cls}</div>
                    <Icon name="arrow-right" size={16} strokeWidth={2.4} class="text-slate-300 transition-colors group-hover:text-[#1d4ed8]" />
                  </div>
                  <h3 class="mt-2 font-display text-lg font-extrabold tracking-tight text-slate-900">{c.count} Result Gazettes</h3>
                  <p class="mt-3 text-sm leading-relaxed text-slate-500">Years: {c.years[0]}{c.years.length > 1 ? `-${c.years[c.years.length - 1]}` : ''}</p>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</BaseLayout>
