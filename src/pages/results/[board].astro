---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { BOARDS, boardBySlug, itemBoards } from '../../lib/boards';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return BOARDS.map(board => ({
    params: { board: board.slug },
  }));
}

const boardSlug = Astro.params.board!;
const board = boardBySlug(boardSlug);

if (!board) {
  throw new Error(`Unknown board slug: ${boardSlug}`);
}

const allGazettes = await getCollection('gazettes');

const gazettes = allGazettes
  .filter(g => itemBoards(g.data).includes(board.name))
  .sort((a, b) => {
    const yearDifference = Number(b.data.year) - Number(a.data.year);
    if (yearDifference) return yearDifference;
    return String(a.data.title).localeCompare(String(b.data.title));
  });

const classes = [...new Set(
  gazettes.map(g => String(g.data.class)).filter(Boolean)
)].sort((a, b) => Number(a) - Number(b));

const years = [...new Set(
  gazettes.map(g => Number(g.data.year)).filter(y => Number.isFinite(y) && y > 0)
)].sort((a, b) => b - a);

const site = 'https://malikjeerajajee-coder.github.io/My-edu-site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Board Results', item: `${site}/results/` },
      { '@type': 'ListItem', position: 3, name: `${board.full} Results`, item: `${site}/results/${board.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${board.full} Results and Gazette Documents | TaleemMarkaz`,
    description: `Browse available ${board.full} examination result gazettes by class and year.`,
    url: `${site}/results/${board.slug}/`,
    isPartOf: { '@type': 'WebSite', name: 'TaleemMarkaz', url: `${site}/` },
    numberOfItems: gazettes.length,
  },
];
---
<BaseLayout
  title={`${board.full} Results & Gazette Records | TaleemMarkaz`}
  description={`Browse ${board.full} result gazettes available on TaleemMarkaz. Find listed examination documents by class, exam type and year${years.length ? `, covering ${Math.min(...years)}–${Math.max(...years)}` : ''}.`}
  noindex={gazettes.length === 0}
  jsonLd={jsonLd}
>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[1200px] px-5 py-12 sm:px-7 lg:px-10 lg:py-16">
      <nav class="mb-5 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-400">
        <a href={url('/')} class="hover:text-blue-700">Home</a>
        <span>/</span>
        <a href={url('/results')} class="hover:text-blue-700">Board Results</a>
        <span>/</span>
        <span class="text-slate-600">{board.name}</span>
      </nav>
      <div class="max-w-4xl">
        <p class="text-sm font-bold uppercase tracking-wider text-blue-700">
          TaleemMarkaz results directory
        </p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
          {board.full} Results
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Browse available result gazettes associated with {board.full}.
          Use the class sections below to find listed examination documents.
          For live result announcements or roll-number searches, consult the
          relevant board's official website.
        </p>
        <div class="mt-5 flex flex-wrap gap-3 text-sm text-slate-600">
          <span class="rounded-lg border border-slate-200 px-3 py-2">
            {gazettes.length} listed documents
          </span>
          <span class="rounded-lg border border-slate-200 px-3 py-2">
            {classes.length} classes represented
          </span>
          {years.length > 0 && (
            <span class="rounded-lg border border-slate-200 px-3 py-2">
              Years {Math.min(...years)}–{Math.max(...years)}
            </span>
          )}
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-[1200px] px-5 py-12 sm:px-7 lg:px-10 lg:py-16">
    {gazettes.length > 0 ? (
      <>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">
          Available result gazettes by class
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          Documents are shown from newest to oldest according to their recorded year.
        </p>

        <div class="mt-7 space-y-8">
          {classes.map(cls => {
            const items = gazettes.filter(g => String(g.data.class) === cls);
            return (
              <section class="rounded-xl border border-slate-200 p-5 sm:p-6">
                <h3 class="text-xl font-extrabold text-slate-900">
                  Class {cls} Result Gazettes
                </h3>
                <p class="mt-1 text-sm text-slate-500">
                  {items.length} listed document{items.length === 1 ? '' : 's'}
                </p>
                <ul class="mt-4 divide-y divide-slate-100">
                  {items.map(g => (
                    <li class="py-4 first:pt-0 last:pb-0">
                      <a
                        href={url(`/gazettes/${g.id}`)}
                        class="font-bold leading-relaxed text-blue-700 hover:underline"
                      >
                        {g.data.title}
                      </a>
                      <p class="mt-1 text-sm text-slate-600">
                        {g.data.bise ? `${g.data.bise} Board · ` : ''}
                        Class {g.data.class} · {g.data.examType} · {g.data.year}
                      </p>
                      <a
                        href={url(`/gazettes/${g.id}`)}
                        class="mt-2 inline-block text-sm font-semibold text-slate-600 hover:text-blue-700"
                      >
                        View gazette details →
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </>
    ) : (
      <section class="rounded-xl border border-slate-200 p-6">
        <h2 class="text-xl font-extrabold text-slate-900">
          No gazette records listed yet
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          This board currently has no matching gazette records in our directory.
          Check the board's official website for examination results and announcements.
        </p>
      </section>
    )}

    <section class="mt-12 rounded-xl border border-slate-200 p-6">
      <h2 class="text-lg font-extrabold text-slate-900">
        More education resources
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">
        Explore other study material and the complete gazette directory.
      </p>
      <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold">
        <a href={url(`/board/${board.slug}`)} class="text-blue-700 hover:underline">
          {board.name} study resources
        </a>
        <a href={url('/gazettes')} class="text-blue-700 hover:underline">
          All result gazettes
        </a>
        <a href={url('/results')} class="text-blue-700 hover:underline">
          All board results
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
