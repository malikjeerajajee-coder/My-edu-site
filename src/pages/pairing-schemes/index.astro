---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="Pairing Schemes — Coming Soon | TaleemMarkaz" description="Official board pairing schemes with chapter-wise marks distribution are coming soon to TaleemMarkaz." noindex={true}>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[820px] px-5 py-20 text-center sm:px-7 lg:px-10">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#eff4ff] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[#1d4ed8]">Coming soon</span>
      <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Pairing schemes are on the way</h1>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">Official chapter-wise marks distribution so you study what actually carries marks. Meanwhile, check the exam patterns on past-paper hubs:</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href={url('/past-papers')} class="rounded-xl bg-[#1d4ed8] px-5 py-3 text-sm font-bold text-white hover:bg-[#1e3a8a]">Browse past papers</a>
      </div>
    </div>
  </section>
</BaseLayout>
