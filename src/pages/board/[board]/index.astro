---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { url } from '../../../lib/url';
import { BOARDS } from '../../../lib/boards';
import { getBoardContent } from '../../../lib/boardContent';
import { getBoardInfo } from '../../../lib/boardInfo';

export async function getStaticPaths() {
  return BOARDS.map(b => ({ params: { board: b.slug } }));
}

const { board: slug } = Astro.params;
const data = await getBoardContent(slug!);
if (!data) return Astro.redirect('/boards');
const { board, classes, notes, quizzes, books, gazettes, pastPapers, guessPapers, pairingSchemes, total } = data;
const info = getBoardInfo(slug!);

const SITE = 'https://malikjeerajajee-coder.github.io/My-edu-site';
const canonical = `${SITE}/board/${slug}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Boards', item: `${SITE}/boards/` },
    { '@type': 'ListItem', position: 3, name: board.full, item: canonical },
  ],
};

const faqJsonLd = info?.faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: info.faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;
---
<BaseLayout
  title={`${board.full} — Class 9 to 12 Notes, Past Papers & Gazettes | TaleemHub`}
  description={`Everything for ${board.full}: notes, past papers, guess papers, pairing schemes, quizzes and result gazettes for Class 9, 10, 11 and 12. Free PDF downloads.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="mx-auto max-w-[1320px] px-4 pt-10 sm:px-6 sm:pt-14 lg:px-8">
    <a href={url('/boards')} class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-neutral-500 hover:text-[#1d4ed8]">
      <Icon name="arrow-left" size={16} strokeWidth={2.4} /> All boards
    </a>

    <!-- HERO -->
    <div class="border-b border-neutral-200 pb-10 text-neutral-900">
      <span class="inline-flex items-center gap-1.5 rounded-md bg-[#eef2fe] px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-[#1d4ed8]">
        <Icon name="graduation-cap" size={13} strokeWidth={2.4} /> Board
      </span>
      <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{board.full}</h1>
      <p class="mt-3 max-w-3xl text-base leading-relaxed text-neutral-600">
        {info?.overview || `All study material for ${board.full}: notes, past papers, guess papers and more.`}
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div>
          <span class="text-2xl font-extrabold text-neutral-900">{classes.length}</span>
          <span class="ml-1 text-neutral-600">{classes.length === 1 ? 'class' : 'classes'}</span>
        </div>
        <div>
          <span class="text-2xl font-extrabold text-neutral-900">{total}</span>
          <span class="ml-1 text-neutral-600">items</span>
        </div>
        {info && (
          <div>
            <span class="text-2xl font-extrabold text-neutral-900">{info.boardsServed.length}</span>
            <span class="ml-1 text-neutral-600">BISE boards served</span>
          </div>
        )}
      </div>
    </div>

    <!-- PICK YOUR CLASS -->
    <section class="mt-12">
      <h2 class="mb-6 text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Pick your class</h2>
      {classes.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-neutral-300 bg-white p-12 text-center">
          <p class="text-base font-bold text-neutral-900">No content yet for {board.name}</p>
          <p class="mt-1 text-sm text-neutral-500">Check back soon.</p>
        </div>
      ) : (
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          {classes.map(c => {
            const count = notes.filter((i: any) => i.data.class === c).length
              + quizzes.filter((i: any) => i.data.class === c).length
              + books.filter((i: any) => i.data.class === c).length
              + pastPapers.filter((i: any) => i.data.class === c).length
              + guessPapers.filter((i: any) => i.data.class === c).length
              + pairingSchemes.filter((i: any) => i.data.class === c).length
              + gazettes.filter((i: any) => i.data.class === c).length;
            return (
              <a href={url(`/board/${slug}/class-${c}`)} class="group rounded-2xl border border-neutral-200 bg-white p-6 transition-colors hover:border-[#1d4ed8]">
                <span class="grid h-12 w-12 place-items-center rounded-xl bg-[#eef2fe] text-[#1d4ed8]">
                  <Icon name="graduation-cap" size={22} strokeWidth={2.2} />
                </span>
                <h3 class="mt-5 text-2xl font-extrabold tracking-tight text-neutral-900">Class {c}</h3>
                <p class="mt-1 text-sm text-neutral-500">{count} {count === 1 ? 'item' : 'items'}</p>
              </a>
            );
          })}
        </div>
      )}
    </section>

    {info && (
      <>
        <!-- BOARDS SERVED -->
        <section class="mt-14 rounded-3xl border border-neutral-200 bg-neutral-50 p-8 sm:p-10">
          <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Boards covered</h2>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-500">
            {info.overview}
          </p>
          <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
            {info.boardsServed.map(b => (
              <div class="flex items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-4 py-3">
                <span class="h-1.5 w-1.5 rounded-full bg-[#1d4ed8] text-white"></span>
                <span class="text-sm font-bold text-neutral-800">{b}</span>
              </div>
            ))}
          </div>
        </section>

        <!-- EXAM OVERVIEW -->
        <section class="mt-14">
          <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Exam overview</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            Everything you need to know about the SSC Part-I (Class 9) examination under {board.full}.
          </p>

          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-2xl border border-neutral-200 bg-white p-6">
              <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Total marks</div>
              <div class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-900">{info.totalMarks}</div>
              <div class="mt-1 text-xs text-neutral-500">Across all subjects</div>
            </div>
            <div class="rounded-2xl border border-neutral-200 bg-white p-6">
              <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Passing marks</div>
              <div class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-900">{info.passingMarks}</div>
              <div class="mt-1 text-xs text-neutral-500">33% of {info.totalMarks}</div>
            </div>
            <div class="rounded-2xl border border-neutral-200 bg-white p-6">
              <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Subjects</div>
              <div class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-900">8</div>
              <div class="mt-1 text-xs text-neutral-500">4 compulsory + 4 elective</div>
            </div>
            <div class="rounded-2xl border border-neutral-200 bg-white p-6">
              <div class="text-[11px] font-bold uppercase tracking-wider text-neutral-400">Exam months</div>
              <div class="mt-2 text-xl font-extrabold leading-tight tracking-tight text-neutral-900">March – May</div>
              <div class="mt-1 text-xs text-neutral-500">Annual session</div>
            </div>
          </div>
        </section>

        <!-- SUBJECTS & MARKS -->
        <section class="mt-14">
          <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Subjects and marks distribution</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            Here's how the {info.totalMarks} marks are split across the 8 subjects in the Science group.
          </p>

          <div class="mt-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white">
            <table class="w-full text-left text-sm">
              <thead class="bg-neutral-50 text-[11px] font-bold uppercase tracking-wider text-neutral-500">
                <tr>
                  <th class="px-5 py-3.5">Subject</th>
                  <th class="px-5 py-3.5">Type</th>
                  <th class="px-5 py-3.5 text-right">Marks</th>
                </tr>
              </thead>
              <tbody>
                {info.subjects.map(s => (
                  <tr class="border-t border-neutral-200">
                    <td class="px-5 py-3.5 font-semibold text-neutral-900">{s.name}</td>
                    <td class="px-5 py-3.5">
                      <span class:list={[
                        "inline-block rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide",
                        s.type === 'compulsory' ? "bg-[#eef2fe] text-[#1d4ed8]" : "bg-neutral-100 text-neutral-600"
                      ]}>
                        {s.type}
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-right font-extrabold text-neutral-900">{s.marks}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- PAPER PATTERN -->
        <section class="mt-14">
          <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Paper pattern by subject</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            The exact structure of each paper — objective, subjective, and time allowed.
          </p>

          <div class="mt-6 overflow-hidden rounded-2xl border border-neutral-200 bg-white">
            <table class="w-full text-left text-sm">
              <thead class="bg-neutral-50 text-[11px] font-bold uppercase tracking-wider text-neutral-500">
                <tr>
                  <th class="px-5 py-3.5">Subject</th>
                  <th class="px-5 py-3.5">Total</th>
                  <th class="px-5 py-3.5">Objective</th>
                  <th class="px-5 py-3.5">Subjective</th>
                  <th class="px-5 py-3.5">Duration</th>
                </tr>
              </thead>
              <tbody>
                {info.paperPatterns.map(p => (
                  <tr class="border-t border-neutral-200">
                    <td class="px-5 py-3.5 font-bold text-neutral-900">{p.subject}</td>
                    <td class="px-5 py-3.5 font-extrabold text-neutral-900">{p.totalMarks}</td>
                    <td class="px-5 py-3.5 text-neutral-600">{p.objective}</td>
                    <td class="px-5 py-3.5 text-neutral-600">{p.subjective}</td>
                    <td class="px-5 py-3.5 text-neutral-600">{p.duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- GROUPS -->
        <section class="mt-14">
          <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Groups and subject combinations</h2>
          <p class="mt-3 text-sm leading-relaxed text-neutral-500">
            Students choose one of two groups when entering 9th class.
          </p>
          <div class="mt-6 grid gap-4 lg:grid-cols-2">
            {info.groups.map(g => (
              <div class="rounded-2xl border border-neutral-200 bg-white p-6">
                <h3 class="text-lg font-extrabold tracking-tight text-neutral-900">{g.name}</h3>
                <ul class="mt-4 space-y-2">
                  {g.subjects.map(s => (
                    <li class="flex items-start gap-2.5 text-sm text-neutral-600">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#1d4ed8] text-white"></span>
                      <span>{s}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- FAQ -->
        {info.faq.length > 0 && (
          <section class="mt-14">
            <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900 sm:text-3xl">Frequently asked questions</h2>
            <div class="mt-6 space-y-3">
              {info.faq.map((f, i) => (
                <details class="group rounded-2xl border border-neutral-200 bg-white open:bg-neutral-50" open={i === 0}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-bold text-neutral-900">
                    <span>{f.q}</span>
                    <Icon name="chevron-right" size={18} strokeWidth={2.4} class="shrink-0 text-neutral-400 transition-transform group-open:rotate-90" />
                  </summary>
                  <div class="border-t border-neutral-200 px-6 py-5 text-sm leading-relaxed text-neutral-600">
                    {f.a}
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- PUNJAB BOARD RESULTS LINK -->
        <section class="mt-14 pb-20">
          <div class="border-b border-neutral-200 pb-10 pt-2 text-neutral-900">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:gap-6">
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[#eef2fe] text-[#1d4ed8]">
                <Icon name="newspaper" size={26} strokeWidth={2.2} />
              </span>
              <div class="min-w-0 flex-1">
                <h2 class="text-xl font-extrabold tracking-tight text-neutral-900 sm:text-2xl">Looking for your result?</h2>
                <p class="mt-1 text-sm text-neutral-500">Download the latest {board.name} result gazettes for Class 9 and Class 10.</p>
              </div>
              <a href={url('/gazettes')} class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-[#1d4ed8] px-5 py-3 text-sm font-bold text-white hover:bg-[#110176] !text-white">
                View gazettes <Icon name="arrow-right" size={15} strokeWidth={2.6} />
              </a>
            </div>
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>
