---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="Study Notes — Coming Soon | TaleemMarkaz" description="Chapter-wise study notes and revision summaries for Pakistani boards are coming soon to TaleemMarkaz." noindex={true}>
  <section class="border-b border-slate-200">
    <div class="mx-auto max-w-[820px] px-5 py-20 text-center sm:px-7 lg:px-10">
      <span class="inline-flex items-center gap-2 rounded-full bg-[#eff4ff] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-[#1d4ed8]">Coming soon</span>
      <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Study notes are on the way</h1>
      <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">Chapter-wise notes, solved examples and quick revision summaries for every subject. Meanwhile, download official textbooks:</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <a href={url('/books')} class="rounded-xl bg-[#1d4ed8] px-5 py-3 text-sm font-bold text-white hover:bg-[#1e3a8a]">Browse textbooks</a>
        <a href={url('/past-papers')} class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 hover:border-[#1d4ed8] hover:text-[#1d4ed8]">Past papers</a>
      </div>
    </div>
  </section>
</BaseLayout>
